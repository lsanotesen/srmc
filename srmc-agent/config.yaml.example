# ========================================
# SRMC Agent 配置文件
# ========================================
# 
# 部署说明：
# 1. 物理机部署：复制为 /etc/srmc-agent/config.yaml
# 2. Docker部署：复制为 ./config.yaml 放在 docker-compose.yml 同目录
#
# 必填项：server.url, server.token
# 可选项：agent.uuid, agent.name, agent.ip（留空自动处理）
# ========================================

# 服务器连接配置
server:
  # SRMC 后端 WebSocket 地址
  # 示例: ws://192.168.12.79:8000/ws/agent/
  #       wss://srmc.example.com/ws/agent/
  url: "wss://srmc.example.com/ws/agent/"
  
  # 认证令牌，从 SRMC 后台获取
  # 在 SRMC 管理界面 -> 系统设置 -> Agent Token
  token: "your-token"

# Agent 身份配置
agent:
  # UUID（留空自动生成）
  # - 留空: 首次启动自动生成，保存到 .agent_uuid 文件
  # - 指定: 手动设置 UUID（用于替换已注册的 Agent）
  # 注意：UUID 用于唯一标识 Agent，一般不需要手动设置
  uuid: ""
  
  # Agent 名称（留空使用主机名）
  # - 留空: 自动使用系统主机名（如 isi-12-195）
  # - 指定: 在 SRMC 界面显示的名称（如 生产服务器-195）
  # 建议：填写一个有意义的名称，方便在界面上区分
  name: ""
  
  # Agent IP 地址（留空自动检测）
  # - 留空: 自动检测本机 IP
  # - 指定: 手动指定 IP（多网卡服务器建议指定）
  # 说明：如果服务器有多个网卡，自动检测可能选错网卡
  ip: ""

# 服务状态采集配置
collector:
  # 服务状态检查间隔（秒）
  # Agent 每隔多少秒检查一次服务运行状态
  interval: 2
  
  # 心跳间隔（秒）
  # Agent 每隔多少秒向服务器发送心跳
  heartbeat_interval: 15

# 服务管理配置
manager:
  # 命令执行超时（秒）
  # 启动/停止/重启服务的最大等待时间
  timeout: 30

# Docker 配置
docker:
  # Docker socket 路径
  # 物理机部署: unix:///var/run/docker.sock
  # Docker部署: 保持默认即可
  socket: "unix:///var/run/docker.sock"

# Systemd 配置
systemd:
  # 是否使用 D-Bus 与 systemd 通信
  # 物理机部署建议: true
  # Docker部署建议: false（容器内一般没有 systemd）
  use_dbus: true
