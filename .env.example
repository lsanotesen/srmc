# 加密密钥（32字节base64编码）
SECRET_KEY=your-32-byte-secret-key-base64-encoded

# JWT密钥
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 数据库连接
DATABASE_URL=mysql+pymysql://srmc:srmc123@mysql:3306/srmc?charset=utf8mb4

# Redis连接
REDIS_URL=redis://redis:6379/0

# 审计日志保留天数
AUDIT_LOG_RETENTION_DAYS=90

# SSH配置
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30
SSH_IDLE_TIMEOUT=600
SSH_RETRY_COUNT=2

# 批量操作并发数
BATCH_MAX_WORKERS=5

# 日志级别
LOG_LEVEL=INFO